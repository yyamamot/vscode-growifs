{
  "name": "vscode-growifs",
  "displayName": "growifs",
  "publisher": "yyamamot",
  "private": true,
  "description": "VS Code extension bootstrap for GROWI virtual filesystem integration",
  "categories": [
    "Other"
  ],
  "version": "0.0.8",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyamamot/vscode-growifs.git"
  },
  "packageManager": "pnpm@10.30.3",
  "activationEvents": [
    "onFileSystem:growi",
    "onStartupFinished",
    "onCommand:growi.configureBaseUrl",
    "onCommand:growi.configureApiToken",
    "onCommand:growi.openReadme",
    "onCommand:growi.addPrefix",
    "onCommand:growi.addCurrentPageBookmark",
    "onCommand:growi.openPrefixRootPage",
    "onCommand:growi.openDirectoryPage",
    "onCommand:growi.showExplorerItemActions",
    "onCommand:growi.explorerOpenPageItem",
    "onCommand:growi.explorerOpenPageInBrowser",
    "onCommand:growi.explorerCreatePageHere",
    "onCommand:growi.explorerRenamePage",
    "onCommand:growi.explorerDeletePage",
    "onCommand:growi.explorerRefreshCurrentPage",
    "onCommand:growi.explorerShowBacklinks",
    "onCommand:growi.explorerShowCurrentPageInfo",
    "onCommand:growi.explorerShowCurrentPageAttachments",
    "onCommand:growi.explorerShowRevisionHistoryDiff",
    "onCommand:growi.explorerCreateLocalMirrorForCurrentPage",
    "onCommand:growi.explorerCreateLocalMirrorForCurrentPrefix",
    "onCommand:growi.explorerCompareLocalMirrorWithGrowi",
    "onCommand:growi.explorerUploadLocalMirrorToGrowi",
    "onCommand:growi.explorerCompareLocalMirrorSubtreeWithGrowi",
    "onCommand:growi.explorerUploadLocalMirrorSubtreeToGrowi",
    "onCommand:growi.clearPrefixes",
    "onCommand:growi.deletePrefix",
    "onCommand:growi.createPage",
    "onCommand:growi.deletePage",
    "onCommand:growi.removeCurrentPageBookmark",
    "onCommand:growi.renamePage",
    "onCommand:growi.openPage",
    "onCommand:growi.startEdit",
    "onCommand:growi.endEdit",
    "onCommand:growi.showCurrentPageActions",
    "onCommand:growi.openCurrentPageHub",
    "onCommand:growi.showLocalMirrorActions",
    "onCommand:growi.refreshCurrentPage",
    "onCommand:growi.refreshListing",
    "onCommand:growi.clearRuntimeLogs",
    "onCommand:growi.revealRuntimeLogs",
    "onCommand:growi.showBookmarks",
    "onCommand:growi.createLocalMirrorForCurrentPage",
    "onCommand:growi.createLocalMirrorForCurrentPrefix",
    "onCommand:growi.refreshLocalMirror",
    "onCommand:growi.compareLocalMirrorWithGrowi",
    "onCommand:growi.uploadLocalMirrorToGrowi",
    "onCommand:growi.installLlmSkillPack",
    "onCommand:growi.startLlmEditSession",
    "onCommand:growi.createLlmLocalMirrorDiffContext",
    "onCommand:growi.scmUploadMirrorResources",
    "onCommand:growi.scmTakeRemoteMirrorResources",
    "onCommand:growi.showCurrentPageInfo",
    "onCommand:growi.showCurrentPageAttachments",
    "onCommand:growi.showBacklinks",
    "onCommand:growi.showRevisionHistoryDiff"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "commands": [
      {
        "command": "growi.configureBaseUrl",
        "title": "%command.growi.configureBaseUrl.title%"
      },
      {
        "command": "growi.configureApiToken",
        "title": "%command.growi.configureApiToken.title%"
      },
      {
        "command": "growi.openReadme",
        "title": "%command.growi.openReadme.title%"
      },
      {
        "command": "growi.createPage",
        "title": "%command.growi.createPage.title%",
        "shortTitle": "%command.growi.createPage.shortTitle%"
      },
      {
        "command": "growi.addCurrentPageBookmark",
        "title": "%command.growi.addCurrentPageBookmark.title%"
      },
      {
        "command": "growi.deletePage",
        "title": "%command.growi.deletePage.title%"
      },
      {
        "command": "growi.removeCurrentPageBookmark",
        "title": "%command.growi.removeCurrentPageBookmark.title%"
      },
      {
        "command": "growi.renamePage",
        "title": "%command.growi.renamePage.title%"
      },
      {
        "command": "growi.addPrefix",
        "title": "%command.growi.addPrefix.title%",
        "shortTitle": "%command.growi.addPrefix.shortTitle%",
        "icon": "$(add)"
      },
      {
        "command": "growi.openPrefixRootPage",
        "title": "%command.growi.openPrefixRootPage.title%"
      },
      {
        "command": "growi.openDirectoryPage",
        "title": "%command.growi.openDirectoryPage.title%"
      },
      {
        "command": "growi.showExplorerItemActions",
        "title": "%command.growi.showExplorerItemActions.title%"
      },
      {
        "command": "growi.explorerOpenPageItem",
        "title": "%command.growi.explorerOpenPageItem.title%"
      },
      {
        "command": "growi.explorerOpenPageInBrowser",
        "title": "%command.growi.explorerOpenPageInBrowser.title%"
      },
      {
        "command": "growi.explorerCreatePageHere",
        "title": "%command.growi.explorerCreatePageHere.title%"
      },
      {
        "command": "growi.explorerRenamePage",
        "title": "%command.growi.explorerRenamePage.title%"
      },
      {
        "command": "growi.explorerDeletePage",
        "title": "%command.growi.explorerDeletePage.title%"
      },
      {
        "command": "growi.explorerRefreshCurrentPage",
        "title": "%command.growi.explorerRefreshCurrentPage.title%"
      },
      {
        "command": "growi.explorerShowBacklinks",
        "title": "%command.growi.explorerShowBacklinks.title%"
      },
      {
        "command": "growi.explorerShowCurrentPageInfo",
        "title": "%command.growi.explorerShowCurrentPageInfo.title%"
      },
      {
        "command": "growi.explorerShowCurrentPageAttachments",
        "title": "%command.growi.explorerShowCurrentPageAttachments.title%"
      },
      {
        "command": "growi.explorerShowRevisionHistoryDiff",
        "title": "%command.growi.explorerShowRevisionHistoryDiff.title%"
      },
      {
        "command": "growi.explorerCompareLocalMirrorWithGrowi",
        "title": "%command.growi.explorerCompareLocalMirrorWithGrowi.title%"
      },
      {
        "command": "growi.explorerUploadLocalMirrorToGrowi",
        "title": "%command.growi.explorerUploadLocalMirrorToGrowi.title%"
      },
      {
        "command": "growi.explorerCompareLocalMirrorSubtreeWithGrowi",
        "title": "%command.growi.explorerCompareLocalMirrorSubtreeWithGrowi.title%"
      },
      {
        "command": "growi.explorerUploadLocalMirrorSubtreeToGrowi",
        "title": "%command.growi.explorerUploadLocalMirrorSubtreeToGrowi.title%"
      },
      {
        "command": "growi.clearPrefixes",
        "title": "%command.growi.clearPrefixes.title%",
        "shortTitle": "%command.growi.clearPrefixes.shortTitle%",
        "icon": "$(clear-all)"
      },
      {
        "command": "growi.deletePrefix",
        "title": "%command.growi.deletePrefix.title%",
        "shortTitle": "%command.growi.deletePrefix.shortTitle%",
        "icon": "$(trash)"
      },
      {
        "command": "growi.openPage",
        "title": "%command.growi.openPage.title%",
        "shortTitle": "%command.growi.openPage.shortTitle%",
        "icon": "$(search)"
      },
      {
        "command": "growi.startEdit",
        "title": "%command.growi.startEdit.title%"
      },
      {
        "command": "growi.endEdit",
        "title": "%command.growi.endEdit.title%"
      },
      {
        "command": "growi.showCurrentPageActions",
        "title": "%command.growi.showCurrentPageActions.title%"
      },
      {
        "command": "growi.openCurrentPageHub",
        "title": "%command.growi.openCurrentPageHub.title%",
        "category": "GROWI"
      },
      {
        "command": "growi.showBookmarks",
        "title": "%command.growi.showBookmarks.title%",
        "icon": "$(bookmark)"
      },
      {
        "command": "growi.showLocalMirrorActions",
        "title": "%command.growi.showLocalMirrorActions.title%"
      },
      {
        "command": "growi.refreshCurrentPage",
        "title": "%command.growi.refreshCurrentPage.title%"
      },
      {
        "command": "growi.refreshListing",
        "title": "%command.growi.refreshListing.title%",
        "shortTitle": "%command.growi.refreshListing.shortTitle%",
        "icon": "$(refresh)"
      },
      {
        "command": "growi.clearRuntimeLogs",
        "title": "%command.growi.clearRuntimeLogs.title%",
        "icon": "$(trash)"
      },
      {
        "command": "growi.revealRuntimeLogs",
        "title": "%command.growi.revealRuntimeLogs.title%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "growi.explorerCreateLocalMirrorForCurrentPage",
        "title": "%command.growi.explorerCreateLocalMirrorForCurrentPage.title%"
      },
      {
        "command": "growi.explorerCreateLocalMirrorForCurrentPrefix",
        "title": "%command.growi.explorerCreateLocalMirrorForCurrentPrefix.title%"
      },
      {
        "command": "growi.explorerCompareLocalMirrorWithGrowi",
        "title": "%command.growi.explorerCompareLocalMirrorWithGrowi.title%"
      },
      {
        "command": "growi.explorerUploadLocalMirrorToGrowi",
        "title": "%command.growi.explorerUploadLocalMirrorToGrowi.title%"
      },
      {
        "command": "growi.explorerCompareLocalMirrorSubtreeWithGrowi",
        "title": "%command.growi.explorerCompareLocalMirrorSubtreeWithGrowi.title%"
      },
      {
        "command": "growi.explorerUploadLocalMirrorSubtreeToGrowi",
        "title": "%command.growi.explorerUploadLocalMirrorSubtreeToGrowi.title%"
      },
      {
        "command": "growi.createLocalMirrorForCurrentPage",
        "title": "%command.growi.createLocalMirrorForCurrentPage.title%"
      },
      {
        "command": "growi.createLocalMirrorForCurrentPrefix",
        "title": "%command.growi.createLocalMirrorForCurrentPrefix.title%"
      },
      {
        "command": "growi.compareLocalMirrorWithGrowi",
        "title": "%command.growi.compareLocalMirrorWithGrowi.title%"
      },
      {
        "command": "growi.uploadLocalMirrorToGrowi",
        "title": "%command.growi.uploadLocalMirrorToGrowi.title%"
      },
      {
        "command": "growi.installLlmSkillPack",
        "title": "%command.growi.installLlmSkillPack.title%"
      },
      {
        "command": "growi.startLlmEditSession",
        "title": "%command.growi.startLlmEditSession.title%",
        "icon": "$(sparkle)"
      },
      {
        "command": "growi.createLlmLocalMirrorDiffContext",
        "title": "%command.growi.createLlmLocalMirrorDiffContext.title%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "growi.scmUploadMirrorResources",
        "title": "%command.growi.scmUploadMirrorResources.title%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "growi.scmCompareMirrorAgain",
        "title": "%command.growi.scmCompareMirrorAgain.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "growi.scmCheckRemoteMetadata",
        "title": "%command.growi.scmCheckRemoteMetadata.title%",
        "icon": "$(sync)"
      },
      {
        "command": "growi.scmTakeRemoteMirrorResources",
        "title": "%command.growi.scmTakeRemoteMirrorResources.title%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "growi.showCurrentPageInfo",
        "title": "%command.growi.showCurrentPageInfo.title%"
      },
      {
        "command": "growi.showCurrentPageAttachments",
        "title": "%command.growi.showCurrentPageAttachments.title%"
      },
      {
        "command": "growi.showBacklinks",
        "title": "%command.growi.showBacklinks.title%"
      },
      {
        "command": "growi.showRevisionHistoryDiff",
        "title": "%command.growi.showRevisionHistoryDiff.title%"
      }
    ],
    "keybindings": [
      {
        "command": "growi.showExplorerItemActions",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "focusedView == 'growi.explorer'"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "growi.explorer",
          "name": "GROWI"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "growi.explorer",
        "contents": "%viewsWelcome.growi.explorer.noBaseUrl%",
        "when": "config.growi.baseUrl == ''"
      },
      {
        "view": "growi.explorer",
        "contents": "%viewsWelcome.growi.explorer.configured%",
        "when": "config.growi.baseUrl != ''"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "growi.openPage",
          "when": "view == growi.explorer",
          "group": "navigation@1"
        },
        {
          "command": "growi.addPrefix",
          "when": "view == growi.explorer",
          "group": "navigation@2"
        },
        {
          "command": "growi.refreshListing",
          "when": "view == growi.explorer",
          "group": "navigation@3"
        },
        {
          "command": "growi.showBookmarks",
          "when": "view == growi.explorer",
          "group": "navigation@4"
        },
        {
          "command": "growi.clearPrefixes",
          "when": "view == growi.explorer",
          "group": "navigation@5"
        },
        {
          "command": "growi.clearRuntimeLogs",
          "when": "view == growi.explorer && growi.runtimeLogsEnabled",
          "group": "navigation@6"
        },
        {
          "command": "growi.revealRuntimeLogs",
          "when": "view == growi.explorer && growi.runtimeLogsEnabled",
          "group": "navigation@7"
        }
      ],
      "commandPalette": [
        {
          "command": "growi.openCurrentPageHub"
        },
        {
          "command": "growi.clearRuntimeLogs",
          "when": "growi.runtimeLogsEnabled"
        },
        {
          "command": "growi.revealRuntimeLogs",
          "when": "growi.runtimeLogsEnabled"
        },
        {
          "command": "growi.uploadLocalMirrorToGrowi",
          "when": "false"
        },
        {
          "command": "growi.explorerUploadLocalMirrorToGrowi",
          "when": "false"
        },
        {
          "command": "growi.explorerUploadLocalMirrorSubtreeToGrowi",
          "when": "false"
        },
        {
          "command": "growi.scmUploadMirrorResources",
          "when": "false"
        },
        {
          "command": "growi.scmCompareMirrorAgain",
          "when": "false"
        },
        {
          "command": "growi.scmCheckRemoteMetadata",
          "when": "false"
        },
        {
          "command": "growi.scmTakeRemoteMirrorResources",
          "when": "false"
        }
      ],
      "scm/repository": [
        {
          "command": "growi.scmCompareMirrorAgain",
          "when": "scmProvider == growifs-mirror-compare",
          "group": "inline@1"
        },
        {
          "command": "growi.scmCheckRemoteMetadata",
          "when": "scmProvider == growifs-mirror-compare",
          "group": "inline@2"
        },
        {
          "command": "growi.scmUploadMirrorResources",
          "when": "scmProvider == growifs-mirror-compare",
          "group": "inline@3"
        },
        {
          "command": "growi.scmTakeRemoteMirrorResources",
          "when": "scmProvider == growifs-mirror-compare",
          "group": "inline@4"
        },
        {
          "command": "growi.startLlmEditSession",
          "when": "scmProvider == growifs-mirror-compare",
          "group": "inline@5"
        },
        {
          "command": "growi.createLlmLocalMirrorDiffContext",
          "when": "scmProvider == growifs-mirror-compare",
          "group": "inline@6"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "growi.scmUploadMirrorResources",
          "when": "scmProvider == growifs-mirror-compare && scmResourceGroup == changes",
          "group": "navigation@1"
        },
        {
          "command": "growi.scmTakeRemoteMirrorResources",
          "when": "scmProvider == growifs-mirror-compare && scmResourceGroup == remoteChanged",
          "group": "navigation@1"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "growi.scmUploadMirrorResources",
          "when": "scmProvider == growifs-mirror-compare && scmResourceState == growifs.localChanged",
          "group": "navigation@1"
        },
        {
          "command": "growi.scmTakeRemoteMirrorResources",
          "when": "scmProvider == growifs-mirror-compare && scmResourceState == growifs.remoteChanged",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "growi.openPrefixRootPage",
          "when": "view == growi.explorer && viewItem == growi.prefixRoot",
          "group": "inline"
        },
        {
          "command": "growi.openPrefixRootPage",
          "when": "view == growi.explorer && viewItem == growi.prefixRoot",
          "group": "01_open@2"
        },
        {
          "command": "growi.explorerOpenPageInBrowser",
          "when": "view == growi.explorer && viewItem == growi.prefixRoot",
          "group": "01_open@3"
        },
        {
          "command": "growi.explorerCreatePageHere",
          "when": "view == growi.explorer && viewItem == growi.prefixRoot",
          "group": "03_structureEdit@1"
        },
        {
          "command": "growi.explorerCreateLocalMirrorForCurrentPrefix",
          "when": "view == growi.explorer && viewItem == growi.prefixRoot",
          "group": "04_localMirror@2"
        },
        {
          "command": "growi.explorerCompareLocalMirrorSubtreeWithGrowi",
          "when": "view == growi.explorer && viewItem == growi.prefixRoot",
          "group": "04_localMirror@4"
        },
        {
          "command": "growi.deletePrefix",
          "when": "view == growi.explorer && viewItem == growi.prefixRoot",
          "group": "06_danger@2"
        },
        {
          "command": "growi.explorerOpenPageInBrowser",
          "when": "view == growi.explorer && (viewItem == growi.page || viewItem == growi.pageBookmarked)",
          "group": "01_open@3"
        },
        {
          "command": "growi.explorerRefreshCurrentPage",
          "when": "view == growi.explorer && (viewItem == growi.page || viewItem == growi.pageBookmarked)",
          "group": "02_inspect@1"
        },
        {
          "command": "growi.openCurrentPageHub",
          "when": "view == growi.explorer && (viewItem == growi.page || viewItem == growi.pageBookmarked)",
          "group": "02_inspect@2"
        },
        {
          "command": "growi.explorerCreatePageHere",
          "when": "view == growi.explorer && (viewItem == growi.page || viewItem == growi.pageBookmarked)",
          "group": "03_structureEdit@1"
        },
        {
          "command": "growi.explorerRenamePage",
          "when": "view == growi.explorer && (viewItem == growi.page || viewItem == growi.pageBookmarked)",
          "group": "03_structureEdit@2"
        },
        {
          "command": "growi.addCurrentPageBookmark",
          "when": "view == growi.explorer && viewItem == growi.page",
          "group": "03_structureEdit@3"
        },
        {
          "command": "growi.removeCurrentPageBookmark",
          "when": "view == growi.explorer && viewItem == growi.pageBookmarked",
          "group": "03_structureEdit@3"
        },
        {
          "command": "growi.explorerCreateLocalMirrorForCurrentPage",
          "when": "view == growi.explorer && (viewItem == growi.page || viewItem == growi.pageBookmarked)",
          "group": "04_localMirror@1"
        },
        {
          "command": "growi.explorerCompareLocalMirrorWithGrowi",
          "when": "view == growi.explorer && (viewItem == growi.page || viewItem == growi.pageBookmarked)",
          "group": "04_localMirror@3"
        },
        {
          "command": "growi.explorerDeletePage",
          "when": "view == growi.explorer && (viewItem == growi.page || viewItem == growi.pageBookmarked)",
          "group": "06_danger@1"
        },
        {
          "command": "growi.explorerOpenPageInBrowser",
          "when": "view == growi.explorer && (viewItem == growi.directoryPage || viewItem == growi.directoryPageBookmarked)",
          "group": "01_open@3"
        },
        {
          "command": "growi.explorerRefreshCurrentPage",
          "when": "view == growi.explorer && (viewItem == growi.directoryPage || viewItem == growi.directoryPageBookmarked)",
          "group": "02_inspect@1"
        },
        {
          "command": "growi.openCurrentPageHub",
          "when": "view == growi.explorer && (viewItem == growi.directoryPage || viewItem == growi.directoryPageBookmarked)",
          "group": "02_inspect@2"
        },
        {
          "command": "growi.explorerCreatePageHere",
          "when": "view == growi.explorer && (viewItem == growi.directoryPage || viewItem == growi.directoryPageBookmarked)",
          "group": "03_structureEdit@1"
        },
        {
          "command": "growi.explorerRenamePage",
          "when": "view == growi.explorer && (viewItem == growi.directoryPage || viewItem == growi.directoryPageBookmarked)",
          "group": "03_structureEdit@2"
        },
        {
          "command": "growi.addCurrentPageBookmark",
          "when": "view == growi.explorer && viewItem == growi.directoryPage",
          "group": "03_structureEdit@3"
        },
        {
          "command": "growi.removeCurrentPageBookmark",
          "when": "view == growi.explorer && viewItem == growi.directoryPageBookmarked",
          "group": "03_structureEdit@3"
        },
        {
          "command": "growi.explorerCreateLocalMirrorForCurrentPage",
          "when": "view == growi.explorer && (viewItem == growi.directoryPage || viewItem == growi.directoryPageBookmarked)",
          "group": "04_localMirror@1"
        },
        {
          "command": "growi.explorerCreateLocalMirrorForCurrentPrefix",
          "when": "view == growi.explorer && (viewItem == growi.directoryPage || viewItem == growi.directoryPageBookmarked)",
          "group": "04_localMirror@2"
        },
        {
          "command": "growi.explorerCompareLocalMirrorWithGrowi",
          "when": "view == growi.explorer && (viewItem == growi.directoryPage || viewItem == growi.directoryPageBookmarked)",
          "group": "04_localMirror@3"
        },
        {
          "command": "growi.explorerDeletePage",
          "when": "view == growi.explorer && (viewItem == growi.directoryPage || viewItem == growi.directoryPageBookmarked)",
          "group": "06_danger@1"
        },
        {
          "command": "growi.explorerCreatePageHere",
          "when": "view == growi.explorer && viewItem == growi.directory",
          "group": "03_structureEdit@1"
        },
        {
          "command": "growi.explorerCompareLocalMirrorSubtreeWithGrowi",
          "when": "view == growi.explorer && (viewItem == growi.directory || viewItem == growi.prefixRoot)",
          "group": "04_localMirror@4"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "growi.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.growi.baseUrl.markdownDescription%"
        },
        "growi.pageListing.initialPageSize": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "markdownDescription": "%configuration.growi.pageListing.initialPageSize.markdownDescription%"
        },
        "growi.pageListing.maxAutoPagesPerPrefix": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "markdownDescription": "%configuration.growi.pageListing.maxAutoPagesPerPrefix.markdownDescription%"
        },
        "growi.localMirror.maxPrefixPages": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 200,
          "markdownDescription": "%configuration.growi.localMirror.maxPrefixPages.markdownDescription%"
        }
      }
    }
  },
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=22.0.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "deps:check": "pnpm outdated && pnpm audit",
    "deps:update": "pnpm update",
    "deps:update:latest": "pnpm update --latest",
    "deps:verify": "pnpm run build && pnpm run test:unit && pnpm run test:integration && pnpm run lint",
    "typecheck": "tsc --noEmit",
    "lint": "biome check package.json tsconfig.json biome.json README.md README.ja.md CHANGELOG.md CHANGELOG.ja.md AGENTS.md src scripts test",
    "format": "biome format --write package.json tsconfig.json biome.json README.md README.ja.md CHANGELOG.md CHANGELOG.ja.md AGENTS.md src scripts test",
    "build": "esbuild src/extension.ts src/harness/uiReview.ts --bundle --platform=node --format=cjs --outdir=dist --external:vscode",
    "package:vsix": "node ./scripts/vsix.mjs package",
    "install:vsix": "node ./scripts/vsix.mjs install",
    "uninstall:vsix": "node ./scripts/vsix.mjs uninstall",
    "test:unit": "vitest run test/unit",
    "test:integration": "node ./scripts/run-integration.mjs",
    "test:integration:host": "pnpm run build && node ./test/integration/extension-host/launch.mjs",
    "check:system-events": "node ./scripts/check-system-events-shift-f10.mjs",
    "review:ui:scenario": "pnpm run build && node ./scripts/review-ui-scenario.mjs",
    "review:ui:feature": "pnpm run build && node ./scripts/review-ui-feature.mjs",
    "verify:ui-change": "node ./scripts/verify-ui-change.mjs",
    "check:l10n": "node ./scripts/check-l10n.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/node": "^25.4.0",
    "@types/vscode": "^1.105.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "l10n": "./l10n"
}
