      ]
    },
    {
      "id": "growi.explorer.focus"
    },
    {
      "id": "list.expand"
    },
    {
      "id": "list.expand"
    },
    {
      "id": "growi.openPage",
      "args": [
        "/team/dev/alpha"
      ]
    },
    {
      "id": "growi.showCurrentPageActions",
      "quickPick": {
        "kind": "currentPageActions",
        "action": "collectOnly",
