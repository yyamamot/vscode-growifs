{
  "id": "treeview-daily-ops",
  "title": "TreeView-first daily operations UX evidence review",
  "aliases": [
    "treeview-ux",
    "daily-ops"
  ],
  "uiAreas": [
    "explorer",
    "menus",
    "quickPick",
    "localMirror",
    "currentPage"
  ],
  "changedFileGlobs": [
    "package.json",
    "src/extension.ts",
    "src/vscode/prefixTree.ts",
    "src/vscode/commands.ts",
    "src/harness/uiReview.ts",
    "fixtures/harness/**"
  ],
  "target": "TreeView-first daily GROWI operations and LLM usability review",
  "reviewFocus": [
    "TreeView-first discovery for prefix root, directory page, normal page, and partial load-more states.",
    "Whether open, create, rename, delete, bookmark, current-page, and local mirror actions are findable from the TreeView and related menus.",
    "Whether current page actions, local mirror actions, and bookmarks QuickPicks present daily operations in a coherent order with enough context.",
    "Whether the evidence pack is sufficient for an LLM reviewer to propose follow-up IMP candidates without making product UI changes."
  ],
  "uxReviewQuestions": [
    "Can a user understand what the prefix root represents and where the directory page differs from a normal page?",
    "Are destructive or state-changing actions visible with enough context to evaluate risk without executing them in the scenario?",
    "Do current-page, local mirror, and bookmark QuickPicks make the next action obvious for a user starting from the TreeView?",
    "Does partial load-more evidence make it clear that the tree is incomplete and how the user can continue browsing?",
    "Which findings should become separate IMP candidates rather than being fixed as part of this review evidence scenario?"
  ],
  "fixture": {
    "pages": [
      {
        "pageId": "page-dev-root",
        "path": "/team/dev",
        "body": "# team dev page",
        "updatedAt": "2026-03-08T01:00:00.000Z",
        "updatedBy": "system"
      },
      {
        "pageId": "page-alpha",
        "path": "/team/dev/alpha",
        "body": "# alpha page",
        "updatedAt": "2026-03-08T01:01:00.000Z",
        "updatedBy": "alpha-owner"
      },
      {
        "pageId": "page-docs",
        "path": "/team/dev/docs",
        "body": "# docs page",
        "updatedAt": "2026-03-08T01:02:00.000Z",
        "updatedBy": "docs-owner"
      },
      {
        "pageId": "page-guide",
        "path": "/team/dev/docs/guide",
        "body": "# guide page",
        "updatedAt": "2026-03-08T01:03:00.000Z",
        "updatedBy": "guide-owner"
      }
    ],
    "generatedPages": [
      {
        "prefix": "/team/dev/many",
        "count": 101,
        "namePrefix": "page-",
        "bodyPrefix": "# generated page ",
        "updatedBy": "load-more-owner"
      }
    ],
    "bookmarks": [
      {
        "canonicalPath": "/team/dev/alpha",
        "addedAt": "2026-03-08T02:00:00.000Z",
        "pageId": "page-alpha"
      }
    ]
  },
  "tree": {
    "maxDepth": 3
  },
  "commands": [
    {
      "id": "workbench.view.explorer"
    },
    {
      "id": "growi.addPrefix",
      "args": [
