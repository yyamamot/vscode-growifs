      ]
    },
    {
      "id": "growi.openPage",
      "quickPick": {
        "kind": "openPage",
        "query": "sp",
        "select": {
          "canonicalPath": "/team/dev/spec"
        }
      }
    },
    {
      "id": "growi.addCurrentPageBookmark"
    },
    {
      "id": "growi.openPage",
      "args": [
        "/team/dev/docs"
      ]
    },
    {
      "id": "growi.showBookmarks",
      "quickPick": {
        "kind": "bookmarks",
        "select": {
          "canonicalPath": "/team/dev/spec"
        }
      }
    }
  ],
  "checks": {
    "requiredTreeItems": [
      {
        "label": "/team/dev",
        "kind": "directory",
        "canonicalPath": "/team/dev",
        "contextValue": "growi.prefixRoot"
      },
      {
        "label": "__dev__.md",
        "kind": "page",
        "canonicalPath": "/team/dev",
        "contextValue": "growi.directoryPage"
      },
      {
        "label": "spec.md",
        "kind": "page",
        "canonicalPath": "/team/dev/spec",
        "contextValue": "growi.pageBookmarked"
      },
      {
        "label": "docs",
        "kind": "directory",
        "canonicalPath": "/team/dev/docs",
        "contextValue": "growi.directory"
      }
    ],
    "requiredQuickPickItems": [
      {
        "name": "openPage",
        "placeholder": "Filter and select a page under a registered prefix.",
        "value": "sp",
        "item": {
          "label": "spec",
          "description": "/team/dev/spec",
          "canonicalPath": "/team/dev/spec"
        }
      },
      {
        "name": "openPage",
        "value": "sp",
        "item": {
          "label": "Enter URL / path directly",
          "action": "directInput"
        }
      },
      {
        "name": "bookmarks",
        "placeholder": "Select a page from bookmarks.",
        "item": {
          "label": "spec",
          "description": "/team/dev/spec",
          "canonicalPath": "/team/dev/spec"
        }
      }
    ],
    "requiredQuickPickItemOrder": [
