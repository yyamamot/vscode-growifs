    "requiredSelectedQuickPickItems": [
      {
        "name": "openPage",
        "value": "sp",
        "item": {
          "canonicalPath": "/team/dev/spec"
        }
      },
      {
        "name": "bookmarks",
        "item": {
          "canonicalPath": "/team/dev/spec"
        }
