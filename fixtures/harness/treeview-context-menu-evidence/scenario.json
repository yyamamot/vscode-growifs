{
  "id": "treeview-context-menu-evidence",
  "title": "TreeView context menu 3-layer evidence review",
  "aliases": [
    "treeview-context-menu",
    "context-menu-evidence",
    "right-click-evidence"
  ],
  "uiAreas": [
    "explorer",
    "menus",
    "quickPick"
  ],
  "changedFileGlobs": [
    "package.json",
    "src/extension.ts",
    "src/vscode/prefixTree.ts",
    "src/harness/uiReview.ts",
    "fixtures/harness/**",
    "docs/ui/treeview-context-menu.md"
  ],
  "target": "TreeView right-click context menu evidence across native menu, keyboard QuickPick preview, and deterministic package menu model",
  "reviewFocus": [
    "Whether right-click actions differ correctly for prefix root, directory page, virtual directory, bookmarked page, and load-more targets.",
    "Whether the keyboard-accessible GROWI: Show Tree Item Actions QuickPick is a stable visual proxy for the same target-specific action sets.",
    "Whether destructive actions and remote-write-like mirror upload actions are absent or separated according to the context menu policy.",
    "Whether Layer 1 screenshots, Layer 2 QuickPick screenshots, and Layer 3 deterministic menu evidence are sufficient for VLM/LLM review without executing destructive commands."
  ],
  "uxReviewQuestions": [
    "Can a reviewer tell which actions apply to the page itself versus pages under a directory or prefix?",
    "Does the right-click UX avoid exposing page-only actions on virtual directories and load-more rows?",
    "Are dangerous actions labeled clearly enough to distinguish page deletion from prefix removal?",
    "Does the QuickPick preview preserve enough ordering and target context to review right-click UX when native context menu screenshots are unavailable?",
    "Which findings should become follow-up IMP candidates rather than being fixed inside this evidence scenario?"
  ],
  "evidenceLayers": [
    {
      "name": "Layer 1 native context menu screenshot",
      "source": ".tmp/ui-review-pack/.../screenshots/",
      "role": "Best-effort supporting evidence for the actual VS Code right-click surface",
      "status": "supporting"
    },
    {
      "name": "Layer 2 keyboard action preview QuickPick screenshot",
      "source": "ui-state.json quickPicks and screenshots from growi.showExplorerItemActions",
      "role": "Stable visual evidence for target-specific action sets exposed through GROWI: Show Tree Item Actions",
      "status": "stable"
    },
    {
      "name": "Layer 3 deterministic menu model",
      "source": "ui-state.json menus from package.json contributes.menus.view/item/context",
      "role": "Source of truth for menu commands, when clauses, groups, required entries, and forbidden entries",
      "status": "source-of-truth"
    }
  ],
